# Maintainer: notolac <https://github.com/notolac>
# Unofficial GPL-3 fork of JuhRadial MX for Omarchy / learning.
# Original: JuhLabs / Julian Hermstad — https://github.com/JuhLabs/juhradial-mx
# Experimental packaging only. Do NOT publish this PKGBUILD to the AUR.

pkgname=juhradial-mx
pkgver=0.4.4
pkgrel=1
pkgdesc="Unofficial fork of JuhRadial MX (radial menu for Logitech MX Master) — not JuhLabs"
arch=('x86_64')
url="https://github.com/notolac/juhradial-mx"
license=('GPL-3.0-or-later')
depends=(
    'gtk4'
    'gtk4-layer-shell'
    'libadwaita'
    'python'
    'python-gobject'
    'python-pyqt6'
    'python-cairo'
    'python-cryptography'
    'qt6-svg'
    'dbus'
    'systemd-libs'
    'libevdev'
    'hidapi'
)
makedepends=(
    'rust'
    'cargo'
    'git'
    'make'
    'base-devel'
)
optdepends=(
    'ydotool: Wayland keystroke injection (uinput)'
)
provides=("$pkgname")
conflicts=("$pkgname-git")
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/heads/master.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-master"

    cd daemon
    cargo build --release --locked
    cd ..
}

package() {
    cd "$pkgname-master"

    # Install daemon binary
    install -Dm755 daemon/target/release/juhradiald "$pkgdir/usr/bin/juhradiald"

    # Install launcher script
    install -Dm755 scripts/juhradial-mx.sh "$pkgdir/usr/bin/juhradial-mx"

    # Install overlay Python files
    install -dm755 "$pkgdir/usr/share/juhradial"
    install -Dm644 overlay/*.py "$pkgdir/usr/share/juhradial/"

    # Install flow module
    cp -r overlay/flow "$pkgdir/usr/share/juhradial/flow"

    # Install locales
    if [ -d "overlay/locales" ]; then
        cp -r overlay/locales "$pkgdir/usr/share/juhradial/"
    fi

    # Install assets
    install -dm755 "$pkgdir/usr/share/juhradial/assets"
    cp -r assets/* "$pkgdir/usr/share/juhradial/assets/"

    # Install desktop file
    install -Dm644 packaging/juhradial-mx.desktop "$pkgdir/usr/share/applications/juhradial-mx.desktop"

    # Install icon
    install -Dm644 assets/juhradial-mx.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/juhradial-mx.svg"

    # Install systemd user service
    install -Dm644 packaging/systemd/juhradialmx-daemon.service "$pkgdir/usr/lib/systemd/user/juhradialmx-daemon.service"

    # Install udev rules
    install -Dm644 packaging/udev/99-juhradialmx.rules "$pkgdir/usr/lib/udev/rules.d/99-juhradialmx.rules"
    install -Dm644 packaging/udev/60-ydotool-uinput.rules "$pkgdir/usr/lib/udev/rules.d/60-ydotool-uinput.rules"

    # Hyprland / Omarchy Lua snippet (user copies into ~/.config/hypr/)
    install -Dm644 packaging/omarchy/juhradial-hyprland.lua \
        "$pkgdir/usr/share/juhradial/omarchy/juhradial-hyprland.lua"

    # Install license + attribution
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"

    # Install docs
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 CONTRIBUTING.md "$pkgdir/usr/share/doc/$pkgname/CONTRIBUTING.md"
}

post_install() {
    echo ">>> Unofficial fork of JuhRadial MX (not JuhLabs)."
    echo ">>> Original: https://github.com/JuhLabs/juhradial-mx"
    echo ">>> To start (after udev + input group; then logout/reboot):"
    echo "    systemctl --user enable --now juhradialmx-daemon"
    echo "    juhradial-mx"
    echo ">>> Omarchy: paste packaging/omarchy/juhradial-hyprland.lua into ~/.config/hypr/hyprland.lua"
}

post_upgrade() {
    post_install
}
